{
  "version": "2.0.0",
  "tasks": [
    {
      "type": "shell",
      "label": "Build MiniOS (C++20)",
      "command": "g++",
      "args": [
        "-std=c++20",
        "-g",
        "-I${workspaceFolder}/include",
        "${workspaceFolder}/src/kernel/Kernel.cpp",
        "${workspaceFolder}/src/main.cpp",
        "-o",
        "${workspaceFolder}/minios"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "detail": "Compiles MiniOS with C++20 standard using g++"
    }
  ]
}